<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QuotaWidget.Core\QuotaWidget.Core.csproj" />
    <ProjectReference Include="..\..\src\QuotaWidget.Cli\QuotaWidget.Cli.csproj" />
    <ProjectReference Include="..\QuotaWidget.FakeCodex\QuotaWidget.FakeCodex.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../fixtures/claude/claude-quotas.d/session-01.json"
          Link="fixtures/claude/claude-quotas.d/session-01.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/codex/rollout-app-sample.jsonl"
          Link="fixtures/codex/rollout-app-sample.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/codex/rollout-cli-sample.jsonl"
          Link="fixtures/codex/rollout-cli-sample.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/constructed/app-server-blocked.json"
          Link="fixtures/constructed/app-server-blocked.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fixtures/constructed/app-server-multiple-buckets.json"
          Link="fixtures/constructed/app-server-multiple-buckets.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyFakeCodex" AfterTargets="Build">
    <ItemGroup>
      <FakeCodexFiles Include="../QuotaWidget.FakeCodex/bin/$(Configuration)/net10.0/QuotaWidget.FakeCodex*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeCodexFiles)" DestinationFolder="$(OutDir)fake-codex" />
  </Target>
</Project>
