<Window x:Class="QuotaWidget.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Quotas IA" Width="460" Height="520" MaxWidth="7680" MaxHeight="4320" ResizeMode="CanResize"
        WindowStyle="None" ShowInTaskbar="False" Background="{DynamicResource CardBackground}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                           CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="14"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BarTrack}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BarTrack}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SectionSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource SectionSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource CardChrome}" CornerRadius="18" BorderThickness="1"
            BorderBrush="{DynamicResource FrameBorder}" Padding="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="2,2,0,12" Background="Transparent" MouseLeftButtonDown="DragCard">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="30" VerticalAlignment="Top" Background="Transparent">
                        <Path Data="M 12,1 L 15,8 L 22,11 L 15,14 L 12,21 L 9,14 L 2,11 L 9,8 Z M 21,1 L 23,5 M 19,3 L 25,3"
                              Stroke="{DynamicResource BlueAccent}" StrokeThickness="1.3" Stretch="Uniform"
                              Width="24" Height="24" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="CardTitle" Text="Quotas IA" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="4" Height="4" Fill="{DynamicResource StateGreen}" Margin="0,0,5,0" />
                            <TextBlock x:Name="MeasurementAge" FontSize="10" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock x:Name="CollectionTime" Margin="7,0,0,0" FontSize="10"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="RefreshCard"
                            ToolTip="Actualiser" AutomationProperties.Name="Actualiser" />
                    <Button x:Name="ModeButton" Style="{StaticResource IconButton}" Content="&#xE8A9;" Click="ChooseMode"
                            ToolTip="Mode d’affichage" AutomationProperties.Name="Mode d’affichage" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="OpenSettings"
                            ToolTip="Réglages" AutomationProperties.Name="Réglages" />
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" Click="PinCard"
                            ToolTip="Toujours au premier plan" AutomationProperties.Name="Toujours au premier plan" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="HideCard"
                            ToolTip="Masquer la carte" AutomationProperties.Name="Masquer la carte" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer x:Name="CardScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <StackPanel x:Name="Sections" />
        </ScrollViewer>
    </Grid>
    </Border>
</Window>
